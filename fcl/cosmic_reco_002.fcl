# -*- mode:tcl -*-
#------------------------------------------------------------------------------
# n004:
#   tracker: hits+time clusters
#   CRV    : digis+pulses+coincidence clusters
#   CALO   : digis
#
# Usage: mu2e -c daqana/fcl/make_digi_ntuple.fcl -s <input art file> [-n 10]
# 
# hopefully, prolog variables below are not used
# intentionally use v0 calibrations
#-----------------------------------------------------------------------------
BEGIN_PROLOG
#   STN_COMPRESS_MCS    : "compressDigiMCs"                    # "compressRecoMCs" looks dangerous
#   STN_VDHITS_COLL_TAG : "compressDigiMCs:virtualdetector"    #
#   GEN_ID              : "particleGun"                        #    ignore GEN_ID check
#   PDG_ID              : 0                                    # 0: ignore PDG_ID
END_PROLOG

#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"

#include "Offline/DAQ/fcl/prolog.fcl"
#include "Stntuple/fcl/stntuple_prologs.fcl"
#include "daqana/fcl/prolog.fcl"
#include "Stntuple/fcl/stntuple_templates.fcl"
#------------------------------------------------------------------------------
# services.DbService and services.ProditionsService
#------------------------------------------------------------------------------
#include "daqana/fcl/calibration_set_v101.fcl"

services.message.destinations.log.categories.MAKE_SD: {
    # reportEvery :  1
    limit       : 1000   # -1
}

process_name : CosmicReco001

source : {
    module_type : RootInput
    fileNames   : @nil

    # firstEvent  : 500
    maxEvents   : -1
    #   inputCommands: ["keep *",
    #                   "drop *Mu2eEventHeader*_*_*_*"]
}

outputs:  {
    defaultOutput :  { module_type : RootOutput
        fileName       :   "rec.mu2e.cosmics.kpp.%06r_%06s.art"
        outputCommands :  [
                          "drop *_*_*_*",
                          @sequence::Reconstruction.GeneralProducts,
                          @sequence::Reconstruction.HighRecoProducts,
                          @sequence::Reconstruction.MidRecoProducts,
                          "keep mu2e::TimeClusters_*_*_*",
                          "keep *_makeSH_*_*",
                          "keep *_DummyLumiInfo_*_*",
                          "keep *_TriggerResults_*_*",
                          "keep mu2e::CrvRecoPulses_*_*_*",
                          "keep mu2e::CrvDigis_*_*_*",
                          "keep mu2e::CrvDAQerrors_*_*_*",
                          "keep *_eventHeaderFromCFOFragment_*_*",
                          "keep mu2e::CrvCoincidenceClusters_*_*_*",
                          "keep mu2e::CrvStatus_*_*_*",
                          "drop artdaq::*_*_*_*" ,
                          "drop mu2e::CrvDigis_*_NZS_*"
                         ]
    }
}

physics : {
    
    producers : {
        
        CrvDigi :  { module_type : CrvDigisFromArtdaqFragmentsFEBII
            diagLevel       : 0 ## 10
            useROC4asROC2   : true
            # useSubsystem0 : false
        }

        @table::CrvRecoPackage.producers
        
        EWMProducer: { @table::CommonMC.DigiProducers.EWMProducer
            SpillType         : 0       ## offspill
            RecoFromMCTruth   : false   ## default
            RecoFromMCTruthErr: 0       ## default
            InitialPhaseShift : 0       ## optional, set it to zero just in case
        }

        makeSD: { @table::DAQ.producers.makeSD
            debugMode        : 0 ## 1
            debugBits        : ["bit0:1"]
            saveWaveforms    : true
            # dtcHeaderPresent : false
            keyOnMnid        : true ## true    ## default:false
        }
        
        makeSH: { @table::TrkHitReco.producers.makeSH
            # MinimumEnergy : 0.0006
        }
        
        
        TimeCluster : { @table::CosmicReco.SimpleTimeCluster
            minNStrawHits : 8
            minNPanels    : 1
            TimeWindow    : 160 ## assume running with correct calibrations ## 400
            TimeStep      : 50
        }
        
        CaloDigiMaker : { module_type:  CaloDigisFromDTCEvents
            dataType     : 0
            diagLevel    : 0
            useOfflineID : true
        }

        CaloRecoDigiMaker : { @table::CaloReco.CaloRecoDigiMaker
            globalDt : 1572.     ## <T(calo> - T(tracker)>
        }

        CaloHitMaker      : { @table::CaloReco.CaloHitMaker
        }
        
        CaloHitFastMaker  : { @table::CaloReco.CaloHitFastMaker
        }
        
        CaloProtoClusterMaker : { @table::CaloCluster.CaloProtoClusterMaker
        }

        CaloClusterMaker : { @table::CaloCluster.CaloClusterMaker
        }
        
        CaloClusterFastMaker : { @table::CaloCluster.CaloClusterFastMaker
        }

        CrvRecoPulses : { @table::CrvRecoPackage.producers.CrvRecoPulses
            globalDt : 486.  ## <T(CRV)-T(tracker)>
        }

        CrvCoincidenceClusterFinder : { @table::CrvRecoPackage.producers.CrvCoincidenceClusterFinder
        }

        LineFinder : { @table::CosmicReco.LineFinder
            minPeak              : 8
            NSteps               : 5
            StepSize             : 0.25
            TimeClusterCollection: "TimeCluster"
        }

        KKLine : { @table::Reconstruction.producers.KKLine   
        }
    }
    
    filters   : {
        EventIDFilter : { module_type: EventIDFilter
            idsToMatch: [
                         "123680:1-69:*",
                         "123680:70:1-693386", "123680:70:693388-100000000",     ## skip event: 693387:CaloHitFastMaker
                         "123680:71-74:*",
                         "123680:75:1-747808", "123680:75:747810-100000000",     ## 123680:75:747809: CaloHitFastMaker
                         "123680:76-204:*",
                         "123680:205:1-2040079","123680:205:2040081-100000000",
                         "123680:206-869:*",
                         "123680:870:1-8698085","123680:870:8698087-100000000",
                         "123680:871-10000:*"
                        ]
        }
    }
    
    analyzers : {
        MakeDigiNtuple : { @table::daqana.analyzers.MakeDigiNtuple
            makeCalD      : 1
            makeCalH      : 1
            makeCalC      : 1
            
            makeCrvD      : 1
            makeCrvP      : 1
            makeCrvC      : 1
            
            makeFragments : 0
            
            makeSD        : 0
            makeCH        : 1
            makeTC        : 1
            makeTrk       : 1
            saveWaveforms : 0
            
            tcCollTag     : "TimeCluster"   ## "TZClusterFinder"  ##
            ksCollTag     : "KKLine"        ##

            debugMode     : 1
            debugBits: [
                        ## "bit21:1"
                       ]
       }
    }

    # p1 : [ EWMProducer, makeSD, makeSH  ]
    # p2 : [ EWMProducer, makeSD, makeSH, TimeCluster, CrvDigi, CrvRecoPulses, CrvCoincidenceClusterFinder ]
    p2 : [ EventIDFilter, EWMProducer
           , makeSD, makeSH, TimeCluster                           ## tracker
           , CaloDigiMaker, CaloRecoDigiMaker, CaloHitMaker        ## calorimeter
           , CaloProtoClusterMaker, CaloClusterMaker
           # , CaloHitFastMaker, CaloClusterFastMaker
           , CrvDigi, CrvRecoPulses, CrvCoincidenceClusterFinder   ## CRV
           , LineFinder, KKLine
          ]

    e1 : [ MakeDigiNtuple ] ##, defaultOutput ] ## MakeDigiNtuple ] ## 
    # e1 : []

    trigger_paths  : [ p2 ]
    end_paths      : [ e1 ]
}
#------------------------------------------------------------------------------
# 
#------------------------------------------------------------------------------
services.TFileService.fileName   :   "nts.mu2e.cosmics.kpp00s000r001n007.%06r_%06s.root"

services.GeometryService.bFieldFile             : "Offline/Mu2eG4/geom/bfgeom_no_field.txt"
services.GeometryService.inputFile              : "Offline/Mu2eG4/geom/geom_common_extracted.txt"

services.scheduler.wantSummary                  : true

services.message.destinations.log.categories.ArtReport.reportEvery : 1
services.message.destinations.log.categories.ArtReport.limit       : 1000
services.message.destinations.log.categories.ArtReport.timespan    : 300
#------------------------------------------------------------------------------
# tracker final config
#------------------------------------------------------------------------------
#include "Production/JobConfig/reco/NoPileup_epilog.fcl"
#include "Production/JobConfig/reco/OffSpillTiming_epilog.fcl"

physics.producers.KKLine.ModuleSettings.SampleSurfaces : @local::Mu2eKinKal.producers.KKLine.ModuleSettings.SampleSurfaces
#include "PassN/Tracker/TrkReco_epilog.fcl"

## *DONT NEED* includes the same tables, but redefines DbService.purpose and DbService.version ##include "PassN/Tracker/TrkReco_calibrations.fcl"
## *DONT NEED* in a hidden way, redefines the reco path  by adding EWMProducer ##include "PassN/Tracker/TrkRecoFromFragments_epilog.fcl"
#------------------------------------------------------------------------------
# CRV redefinitions
#------------------------------------------------------------------------------
#include "Offline/CRVReco/fcl/epilog_extracted.fcl"
